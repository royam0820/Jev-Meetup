        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'typesafe/jev-1.13', state: $json.state, questions: { queue: { type: 'choice', instructions: 'Dans quel dossier classer cet email ?', criteria: { facturation: 'recu, facture, abonnement, paiement, renouvellement', securite: 'alerte de securite ou de connexion, avis lie au compte', newsletter: 'infolettre, nouveautes produit, promotion marketing', perso: 'message personnel ou professionnel attendant une reponse', spam: 'prospection non sollicitee / arnaque' } } } }) }}",

        "jsCode": "const j = $json;\nconst subject = j.subject || (j.headers && j.headers.subject) || '(sans objet)';\nconst body = j.text || j.snippet || '';\nreturn [{ json: { state: `Objet: ${subject}\\n\\n${body}`, gmailId: j.id } }];\n"

    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const idx = $('Empaqueter (1 appel)').first().json.index;\nconst ans = $json.answers;\nreturn idx.map(e => {\n  const a = ans[e.key] || {};\n  const conf = a.confidence;\n  const label = (conf === undefined || conf < 0.7 || !a.choice) ? 'A revoir (humain)' : a.choice;\n  return { json: { gmailId: e.id, subject: e.subject, choice: a.choice, confidence: conf, label: label } };\n});"
      },

    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst crit = {\n  facturation: 'recu, facture, abonnement, paiement',\n  securite: 'alerte de securite ou de connexion, avis de compte',\n  newsletter: 'infolettre, nouveautes produit, promotion marketing',\n  perso: 'message personnel ou professionnel attendant une reponse',\n  spam: 'prospection non sollicitee / arnaque'\n};\nconst index = [];\nconst questions = {};\nconst lines = [];\nitems.forEach((it, i) => {\n  const j = it.json;\n  const subj = j.subject || (j.headers && j.headers.subject) || '(sans objet)';\n  const snip = j.snippet || j.text || '';\n  const n = i + 1;\n  index.push({ key: 'e' + n, id: j.id, subject: subj });\n  lines.push('EMAIL #' + n + ' : ' + subj + ' \\u2014 ' + snip);\n  questions['e' + n] = { type: 'choice', instructions: 'Pour l EMAIL #' + n + ', dans quel dossier classer ?', criteria: crit };\n});\nreturn [{ json: { n: items.length, index: index,\n  payload: { model: 'typesafe/jev-1.13', state: lines.join('\\n\\n'), questions: questions } } }];"
      },

{
  "manifest_version": 3,
  "name": "Jev Fun AdBlocker (OpenRouter fork)",
  "version": "0.1.0",
  "description": "Fun project: detects ads in real time with Jev (TypeSafe) through OpenRouter and removes their DOM elements. Bring your own OpenRouter API key.",
  "permissions": ["storage"],
  "host_permissions": ["https://openrouter.ai/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "TypeSafe Fun AdBlocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

{
  "name": "unclutter",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kitze/unclutter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "tsx --test tests/*.test.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "wxt": "0.21.4"
  }
}
